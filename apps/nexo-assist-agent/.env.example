NODE_ENV=development

# Local runtime database. Use the root .env.example for the full monorepo.
DATABASE_URL=postgresql://nexo_app:nexo_app_dev@localhost:55432/nexo_assist?schema=public
DIRECT_URL=postgresql://nexo_assist:nexo_assist_dev@localhost:55432/nexo_assist?schema=public

# Optional at startup; required when invoking generation or RAG respectively.
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-120b
OPENAI_API_KEY=

# Local development only. Replace with externally managed secrets elsewhere.
AUTH_JWT_SECRET=nexo-assist-local-jwt-secret-change-before-deployment
AUTH_JWT_ISSUER=nexo-assist
AUTH_JWT_AUDIENCE=nexo-assist-api

TICKET_SERVICE_URL=http://localhost:4112
WEB_ORIGIN=http://localhost:3000
AGENT_PORT=4111
