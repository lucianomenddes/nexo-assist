{
  "name": "nexo-assist-agent",
  "version": "1.0.0",
  "description": "Mastra agent API for Nexo Assist.",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint --max-warnings 0 src",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir ."
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@mastra/core": "1.80.0",
    "@mastra/pg": "1.34.0",
    "@nexo-assist/config": "workspace:*",
    "@nexo-assist/database": "workspace:*",
    "fastify": "5.6.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  }
}
