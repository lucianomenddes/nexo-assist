{
  "name": "nexo-assist-agent",
  "version": "1.0.0",
  "description": "Mastra agent API for Nexo Assist.",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint --max-warnings 0 --rule \"no-unused-vars: off\" src",
    "check-types": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --dir .",
    "rag:ingest": "tsx src/scripts/ingest-knowledge.ts",
    "rag:evaluate": "tsx src/scripts/evaluate-knowledge.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@mastra/core": "1.80.0",
    "@mastra/memory": "^1.39.1",
    "@mastra/observability": "1.23.0",
    "@mastra/pg": "1.34.0",
    "@mastra/rag": "^2.7.1",
    "@nexo-assist/config": "workspace:*",
    "@nexo-assist/database": "workspace:*",
    "@prisma/client": "6.19.0",
    "ai": "^7.0.158",
    "fastify": "5.6.1",
    "jose": "^6.2.14",
    "pdf-parse": "^2.4.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "mastra": "^1.37.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  }
}
