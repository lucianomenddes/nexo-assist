{
  "name": "nexo-assist",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @nexo-assist/database db:generate",
    "db:migrate": "pnpm --filter @nexo-assist/database db:migrate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:deploy": "pnpm --filter @nexo-assist/database db:deploy",
    "db:seed": "pnpm --filter @nexo-assist/database db:seed",
    "dev": "node --env-file-if-exists=.env ./node_modules/turbo/bin/turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @nexo-assist/ticket-service test:e2e",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "vitest": "4.1.6"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
