NODE_ENV=development

# Local PostgreSQL started by Docker Compose. The runtime URL uses the
# non-superuser role; DIRECT_URL is reserved for migrations and administration.
POSTGRES_DB=nexo_assist
POSTGRES_USER=nexo_assist
POSTGRES_PASSWORD=nexo_assist_dev
NEXO_APP_PASSWORD=nexo_app_dev
DATABASE_URL=postgresql://nexo_app:nexo_app_dev@localhost:55432/nexo_assist?schema=public
DIRECT_URL=postgresql://nexo_assist:nexo_assist_dev@localhost:55432/nexo_assist?schema=public

# Optional until the chat generation endpoint is implemented.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini
AUTH_JWT_SECRET=nexo-assist-local-jwt-secret-change-before-deployment
AUTH_JWT_ISSUER=nexo-assist
AUTH_JWT_AUDIENCE=nexo-assist-api

AGENT_PORT=4111
TICKET_SERVICE_PORT=4112
NEXT_PUBLIC_AGENT_URL=http://localhost:4111
